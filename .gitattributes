# Normalise line endings: the whole project runs in Linux containers,
# so every text file must be checked out with LF (CRLF breaks .sh entrypoints
# when they are bind-mounted into Docker).
* text=auto eol=lf

*.sh       text eol=lf
*.sql      text eol=lf
*.conf     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
Dockerfile text eol=lf

# Binary-ish artifacts
*.pdf   binary
*.png   binary
*.jpg   binary
